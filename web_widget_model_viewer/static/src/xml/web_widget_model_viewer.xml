<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web_widget_model_viewer.FieldBinaryModelViewer">
        <div class="o_field_model_viewer w-100">
            <model-viewer t-if="this.modelURL" t-att-src="this.modelURL" style="width:100%;height:320px"
                          alt="3D model" ar="" ar-modes="webxr scene-viewer quick-look" camera-controls="" auto-rotate="" shadow-intensity="1"/>
            <button t-if="this.modelURL" type="button" class="btn btn-sm btn-light mb-2" t-on-click="this.fullscreen">Fullscreen</button>
            <t t-call="web.BinaryField"/>
        </div>
    </t>
</templates>
