<odoo>
 <record id="product_cost_date" model="ir.ui.view">
  <field name="name">product.template.cost.update.date</field><field name="model">product.template</field>
  <field name="inherit_id" ref="product.product_template_form_view"/>
  <field name="arch" type="xml"><xpath expr="//field[@name='categ_id']" position="before"><field name="tw_cost_updated_on" readonly="1"/></xpath></field>
 </record>
 <record id="sale_cost_date" model="ir.ui.view">
  <field name="name">sale.order.cost.update.date</field><field name="model">sale.order</field>
  <field name="inherit_id" ref="sale.view_order_form"/><field name="priority">100</field>
  <field name="arch" type="xml"><xpath expr="//field[@name='order_line']/list/*[self::field[@name='price_unit'] or self::column[.//field[@name='price_unit']]]" position="after"><field name="tw_cost_updated_on" optional="show" readonly="1" invisible="display_type"/></xpath></field>
 </record>
 <record id="light_sale_cost_date" model="ir.ui.view">
  <field name="name">sale.order.light.cost.update.date</field><field name="model">sale.order</field>
  <field name="inherit_id" ref="tw_sale_offer_light.view_order_form_light"/>
  <field name="arch" type="xml"><xpath expr="//field[@name='order_line']/list/*[self::field[@name='price_unit'] or self::column[.//field[@name='price_unit']]]" position="after"><field name="tw_cost_updated_on" optional="show" readonly="1" invisible="display_type"/></xpath></field>
 </record>
 <record id="invoice_cost_date" model="ir.ui.view">
  <field name="name">account.move.cost.update.date</field><field name="model">account.move</field>
  <field name="inherit_id" ref="account.view_move_form"/><field name="priority">100</field>
  <field name="arch" type="xml"><xpath expr="//field[@name='invoice_line_ids']/list/*[self::field[@name='price_unit'] or self::column[.//field[@name='price_unit']]]" position="after"><field name="tw_cost_updated_on" optional="show" readonly="1" invisible="display_type in ('line_section', 'line_subsection', 'line_note')"/></xpath></field>
 </record>
 <record id="light_invoice_cost_date" model="ir.ui.view">
  <field name="name">account.move.light.cost.update.date</field><field name="model">account.move</field>
  <field name="inherit_id" ref="tw_invoice_light.view_move_form_light"/>
  <field name="arch" type="xml"><xpath expr="//field[@name='invoice_line_ids']/list/*[self::field[@name='price_unit'] or self::column[.//field[@name='price_unit']]]" position="after"><field name="tw_cost_updated_on" optional="show" readonly="1" invisible="display_type in ('line_section', 'line_subsection', 'line_note')"/></xpath></field>
 </record>
</odoo>
