<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_littleinka_kpi">
        <field name="name">Little Inka KPI</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_kpi_user" model="res.groups">
        <field name="name">Vede la dashboard</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_littleinka_kpi"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_kpi_manager" model="res.groups">
        <field name="name">Amministratore</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_littleinka_kpi"/>
        <field name="implied_ids" eval="[(4, ref('group_kpi_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
