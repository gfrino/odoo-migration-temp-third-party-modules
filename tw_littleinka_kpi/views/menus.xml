<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_kpi_dashboard" model="ir.actions.client">
        <field name="name">Little Inka KPI</field>
        <field name="tag">tw_littleinka_kpi.dashboard</field>
        <field name="path">littleinka-kpi</field>
    </record>

    <menuitem id="menu_kpi_root" name="Little Inka KPI" sequence="45"
