<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vendite (un rigo per ordine) -->
    <record id="view_kpi_report_search" model="ir.ui.view">
        <field name="name">tw.littleinka.kpi.report.search</field>
        <field name="model">tw.littleinka.kpi.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="sede_id"/>
                <field name="payment_label"/>
                <filter name="online" string="Online" domain="[('sales_type', '=', 'online')]"/>
                <filter name="pos" string="Cassa" domain="[('sales_type', '=', 'pos')]"/>
                <separator/>
                <filter name="date" string="Data" date="date" default_period="month"/>
                <group>
                    <filter name="by_sede" string="Sede" context="{'group_by': 'sede_id'}"/>
                    <filter name="by_type" string="Online / cassa" context="{'group_by': 'sales_type'}"/>
                    <filter name="by_channel" string="Canale" context="{'group_by': 'channel'}"/>
                    <filter name="by_fulfilment" string="Consegna o ritiro" context="{'group_by': 'fulfilment'}"/>
                    <filter name="by_payment" string="Pagamento" context="{'group_by': 'payment_label'}"/>
                    <filter name="by_day" string="Giorno" context="{'group_by': 'date:day'}"/>
                    <filter name="by_hour" string="Ora" context="{'group_by': 'date:hour_number'}"/>
                    <filter name="by_weekday" string="Giorno della settimana" context="{'group_by': 'date:day_of_week'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_kpi_report_pivot" model="ir.ui.view">
        <field name="name">tw.littleinka.kpi.report.pivot</field>
        <field name="model">tw.littleinka.kpi.report</field>
        <field name="arch" type="xml">
            <pivot string="Vendite" sample="1">
                <field name="sede_id" type="row"/>
                <field name="sales_type" type="col"/>
                <field name="amount_total" type="measure"/>
                <field name="order_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_kpi_report_graph" model="ir.ui.view">
        <field name="name">tw.littleinka.kpi.report.graph</field>
        <field name="model">tw.littleinka.kpi.report</field>
        <field name="arch" type="xml">
            <graph string="Vendite" type="bar" stacked="1" sample="1">
                <field name="date" interval="day"/>
                <field name="sales_type"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_kpi_report_list" model="ir.ui.view">
        <field name="name">tw.littleinka.kpi.report.list</field>
        <field name="model">tw.littleinka.kpi.report</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="date"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_total" sum="Fatturato"/>
                <field name="order_count" sum="Ordini" optional="show"/>
                <field name="sede_id"/>
                <field name="sales_type"/>
                <field name="channel"/>
                <field name="fulfilment" optional="show"/>
                <field name="payment_label" optional="show"/>
                <field name="item_count" sum="Pezzi" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_kpi_report" model="ir.actions.act_window">
        <field name="name">Analisi vendite</field>
        <field name="res_model">tw.littleinka.kpi.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_date': 1}</field>
    </record>

    <!-- Prodotti venduti (un rigo per prodotto) -->
    <record id="view_kpi_report_line_search" model="ir.ui.view">
        <field name="name">tw.littleinka.kpi.report.line.search</field>
        <field name="model">tw.littleinka.kpi.report.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_name"/>
                <field name="category_name"/>
                <field name="family_id"/>
                <field name="sede_id"/>
                <filter name="online" string="Online" domain="[('sales_type', '=', 'online')]"/>
                <filter name="pos" string="Cassa" domain="[('sales_type', '=', 'pos')]"/>
                <separator/>
                <filter name="no_family" string="Senza famiglia" domain="[('family_id', '=', False)]"/>
                <separator/>
                <filter name="date" string="Data" date="date" default_period="month"/>
                <group>
                    <filter name="by_family" string="Famiglia" context="{'group_by': 'family_id'}"/>
                    <filter name="by_category" string="Categoria" context="{'group_by': 'category_name'}"/>
                    <filter name="by_product" string="Prodotto" context="{'group_by': 'product_name'}"/>
                    <filter name="by_sede" string="Sede" context="{'group_by': 'sede_id'}"/>
                    <filter name="by_type" string="Online / cassa" context="{'group_by': 'sales_type'}"/>
                    <filter name="by_channel" string="Canale" context="{'group_by': 'channel'}"/>
                    <filter name="by_day" string="Giorno" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_kpi_report_line_pivot" model="ir.ui.view">
        <field name="name">tw.littleinka.kpi.report.line.pivot</field>
        <field name="model">tw.littleinka.kpi.report.line</field>
        <field name="arch" type="xml">
            <pivot string="Prodotti venduti" sample="1">
                <field name="family_id" type="row"/>
                <field name="sales_type" type="col"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_kpi_report_line_graph" model="ir.ui.view">
        <field name="name">tw.littleinka.kpi.report.line.graph</field>
        <field name="model">tw.littleinka.kpi.report.line</field>
        <field name="arch" type="xml">
            <graph string="Prodotti venduti" type="bar" stacked="1" sample="1">
                <field name="family_id"/>
                <field name="sales_type"/>
                <field name="quantity" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_kpi_report_line_list" model="ir.ui.view">
        <field name="name">tw.littleinka.kpi.report.line.list</field>
        <field name="model">tw.littleinka.kpi.report.line</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="product_name"/>
                <field name="quantity" sum="Pezzi"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_total" sum="Fatturato"/>
                <field name="sales_type"/>
                <field name="sede_id"/>
                <field name="date"/>
                <field name="channel" optional="hide"/>
                <field name="family_id" optional="show"/>
                <field name="category_name" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_kpi_report_line" model="ir.actions.act_window">
        <field name="name">Prodotti venduti</field>
        <field name="res_model">tw.littleinka.kpi.report.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_date': 1}</field>
    </record>
</odoo>
